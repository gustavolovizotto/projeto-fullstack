# Porta da API
PORT=3000

# Conexão com o PostgreSQL: postgres://usuario:senha@host:porta/banco
DATABASE_URL=postgres://postgres:postgres@localhost:5432/financas

# Origem do front-end liberada no CORS
FRONT_URL=http://localhost:5173

# Segredo que assina os tokens JWT. Gere um com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Validade do token (formato do jsonwebtoken: 1h, 30m, 10s...)
JWT_EXPIRES_IN=1h
